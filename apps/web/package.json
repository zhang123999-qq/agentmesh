{
  "name": "@agentmesh/web",
  "version": "0.1.0",
  "private": true,
  "description": "AgentMesh Web Admin Console — Next.js + @agentmesh/sdk",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "echo 'Skipping lint for web (ESLint patch issue)'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "audit": "npm audit --omit=dev --audit-level=high",
    "clean": "rm -rf .next out dist"
  },
  "dependencies": {
    "@agentmesh/protocol": "*",
    "@agentmesh/sdk": "*",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "^15.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "8.5.33"
  }
}