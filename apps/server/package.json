{
  "name": "@agentmesh/server",
  "version": "0.1.0",
  "private": true,
  "description": "AgentMesh server — Fastify bootstrap, JSON-RPC dispatcher, plugin registry and structured logging",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "start": "node dist/index.js",
    "seed:admin": "node dist/cli/seed-admin.js",
    "migrate": "node dist/cli/migrate.js",
    "backup": "node dist/cli/backup.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentmesh/core": "*",
    "@agentmesh/protocol": "*",
    "@agentmesh/store": "*",
    "fastify": "^5.6.2",
    "jose": "^6.2.17",
    "pino": "^9.14.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "vitest": "^5.1.0"
  }
}
